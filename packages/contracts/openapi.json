      "post": {
        "operationId": "ingest_report_v1_ingest_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$defs": {
                  "Content": {
                    "additionalProperties": false,
                    "properties": {
                      "attachments": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 10,
                        "title": "Attachments",
                        "type": "array"
                      },
                      "audio_ref": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Audio Ref"
                      },
                      "language": {
                        "anyOf": [
                          {
                            "maxLength": 10,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Language"
                      },
                      "text": {
                        "anyOf": [
                          {
                            "maxLength": 20000,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Text"
                      }
                    },
                    "title": "Content",
                    "type": "object"
                  },
                  "Reporter": {
                    "additionalProperties": false,
                    "properties": {
                      "device_id": {
                        "anyOf": [
                          {
                            "maxLength": 100,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Device Id"
                      },
                      "name": {
                        "anyOf": [
                          {
                            "maxLength": 200,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Name"
                      },
                      "phone": {
                        "anyOf": [
                          {
                            "maxLength": 40,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Phone"
                      },
                      "relation": {
                        "default": "unknown",
                        "enum": [
                          "self",
                          "family",
                          "neighbour",
                          "volunteer",
                          "forwarder",
                          "official",
                          "unknown"
                        ],
                        "title": "Relation",
                        "type": "string"
                      }
                    },
                    "title": "Reporter",
                    "type": "object"
                  },
                  "Source": {
                    "additionalProperties": false,
                    "properties": {
                      "file_sha256": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "File Sha256"
                      },
                      "partner": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Partner"
                      },
                      "ref": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Ref"
                      },
                      "row": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Row"
                      },
                      "simulated": {
                        "default": false,
                        "title": "Simulated",
                        "type": "boolean"
                      },
                      "synced_at": {
                        "anyOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Synced At"
                      },
                      "system": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "System"
                      },
                      "written_at": {
                        "anyOf": [
                          {
                            "format": "date-time",
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Written At"
                      }
                    },
                    "title": "Source",
                    "type": "object"
                  }
                },
                "additionalProperties": false,
                "properties": {
                  "channel": {
                    "enum": [
                      "voice",
                      "whatsapp",
