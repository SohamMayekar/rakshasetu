# RakshaSetu environment. `make env` copies this to .env (never commit .env).
# Everything runs with NO keys: providers fall back to fixture mode, and the
# keyword path creates cases when the language model is off or unavailable.

# --- demo and URLs ---------------------------------------------------------
DEMO_MODE=true                 # enables /v1/demo/* and the sign-in picker, local listener only
PUBLIC_URL=                    # the trycloudflare.com address once the tunnel is up (drawn as a QR at /demo/qr)
LOCAL_PORT=80                  # Caddy local listener: the desk, demo controls (projector uses this)
PUBLIC_PORT=8080               # Caddy public listener: the only port the tunnel points at

# --- secrets (synthetic demo values; change them for anything real) --------
SECRET_KEY=dev-only-change-me              # signs session cookies
PHONE_HASH_KEY=dev-only-phone-hmac-key     # keyed HMAC used to match phones without storing them in clear
PHONE_ENC_KEY=                             # Fernet key for phones at rest; `make keys` prints one
POSTGRES_PASSWORD=rakshasetu-superuser     # container superuser (bootstrap only)
OWNER_DB_PASSWORD=rakshasetu-owner         # rakshasetu_owner: owns tables, runs migrations and the demo reset
APP_DB_PASSWORD=rakshasetu-app             # rakshasetu_app: the API/worker/ticker role (INSERT+SELECT on events)

# --- free-tier providers (PRD §8.4, §12.5). Leave empty for fixture mode ----
SARVAM_API_KEY=                # STT primary (Saaras, signup credits)
GROQ_API_KEY=                  # STT fallback (whisper-large-v3) + LLM primary (gpt-oss-120b)
GEMINI_API_KEY=                # LLM fallback (Gemini Flash free tier; send synthetic data only)

# --- WhatsApp Cloud API test number (P1 #5; optional) ----------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- partners (PRD §11.4); one secret per partner in config/partners.yaml --
PARTNER_DEMO_SECRET=dev-only-partner-secret
