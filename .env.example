# RakshaSetu environment. `make env` copies this to .env (never commit .env).
# Never put a comment on the same line as a value: Docker Compose would read it as the value.
# Everything runs with NO keys: providers fall back to fixture mode, and the
# keyword path creates cases when the language model is off or unavailable.

# --- demo and URLs ---------------------------------------------------------
# enables /v1/demo/* and the sign-in picker, local listener only
DEMO_MODE=true
# the trycloudflare.com address once the tunnel is up (drawn as a QR at /demo/qr)
PUBLIC_URL=
# Caddy local listener: the desk, demo controls (projector uses this)
LOCAL_PORT=80
# Caddy public listener: the only port the tunnel points at
PUBLIC_PORT=8080

# --- secrets (synthetic demo values; change them for anything real) --------
# signs session cookies
SECRET_KEY=dev-only-change-me
# keyed HMAC used to match phones without storing them in clear
PHONE_HASH_KEY=dev-only-phone-hmac-key
# Fernet key for phones at rest; `make keys` prints one
PHONE_ENC_KEY=
# container superuser (bootstrap only)
POSTGRES_PASSWORD=rakshasetu-superuser
# rakshasetu_owner: owns tables, runs migrations and the demo reset
OWNER_DB_PASSWORD=rakshasetu-owner
# rakshasetu_app: the API/worker/ticker role (INSERT+SELECT on events)
APP_DB_PASSWORD=rakshasetu-app

# --- free-tier providers (PRD §8.4, §12.5). Leave empty for fixture mode ----
# STT primary (Saaras, signup credits)
SARVAM_API_KEY=
# STT fallback (whisper-large-v3) + LLM primary (gpt-oss-120b)
GROQ_API_KEY=
# LLM fallback (Gemini Flash free tier; send synthetic data only)
GEMINI_API_KEY=

# Optional: the team's Google Maps key (Geocoding API). When set it answers first (doorway-level precision);
# without it, or over its cap, the free OpenStreetMap geocoders (Photon → Nominatim) answer instead.
GOOGLE_MAPS_API_KEY=

# --- WhatsApp Cloud API test number (P1 #5; optional) ----------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- partners (PRD §11.4); one secret per partner in config/partners.yaml --
PARTNER_DEMO_SECRET=dev-only-partner-secret
# Where the demo partner's webhooks go (signed; PRD §11.4). Empty: nothing is sent. To watch them arrive locally,
# run `make webhook-sink` and set this to http://api:9009/hook, then `make up`. A partner team gives its own URL.
DEMO_PARTNER_WEBHOOK_URL=
